{
  "compilerOptions": {
    "baseUrl": "src",
    "sourceMap": true,
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "target": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
