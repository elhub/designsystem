{
  "name": "@elhub",
  "version": "3.0.0",
  "description": "Elhub design system",
  "workspaces": [
    "./ds-tokens",
    "./ds-icons",
    "./ds-css",
    "./ds-components",
    "./ds-graph",
    "./ds-www"
  ],
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:elhub/elhub-ui-design-system.git"
  },
  "scripts": {
    "checktidy": "npm run lint --ws && npm run prettier --ws && npm run typecheck --ws && npm run test:ci --ws",
    "build": "npm run build --ws",
    "preinstall": "node -v && npm -v",
    "install:all": "npm install && npm install --ws",
    "lint": "npm run knip && npm run lint --ws",
    "lint:fix": "npm run lint:fix --ws",
    "prettier": "npm run prettier --ws",
    "prettier:fix": "npm run prettier:fix --ws",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:prerelease": "changeset pre enter next",
    "publish": "NPM_CONFIG_USERCONFIG=./.tc.npmrc changeset publish",
    "prerelease": "node ./prepare-publish.js",
    "release": "npm run release --ws",
    "test": "npm run test --ws",
    "test:ci": "npm run test:ci --ws",
    "knip": "knip",
    "tidy": "npm run lint:fix --ws && npm run prettier:fix --ws && npm run typecheck --ws",
    "typecheck": "npm run typecheck --ws",
    "update": "ncu -u --deep --peer",
    "ds-components:build": "npm run build -w @elhub/ds-components",
    "ds-css:build": "npm run build -w @elhub/ds-css",
    "ds-tokens:build": "npm run build -w @elhub/ds-tokens",
    "ds-graph:start": "npm run start -w @elhub/ds-graph",
    "ds-www:start": "npm run start -w @elhub/ds-www",
    "ds-www:build": "npm run build -w @elhub/ds-www",
    "clean": "rm -rf dependency-check-bin dependency-check-reports ds-www/build && find . \\( -type d -name \"node_modules\" -o -type d -name \"dist\" -o -type f -name \"stats.json\" \\) -exec rm -rf {} +",
    "prepare": "husky",
    "owasp": "mkdir dependency-check-bin && owasp-dependency-check --project \"user-interface-design-system\" --failOnCVSS 7 --nodeAuditSkipDevDependencies --disableNodeJS",
    "gitleaks": "gitleaks git -c .gitleaks.toml --pre-commit --verbose"
  },
  "peerDependencies": {
    "lodash": "^4.17.21",
    "react": "^18.2.0 || ^19.0.0",
    "styled-components": "^6.1.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.20",
    "@types/node": "^25.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.18.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jsdom": "^25.0.1",
    "knip": "^5.83.0",
    "lint-staged": "^15.5.2",
    "owasp-dependency-check": "etnetera/owasp-dependency-check",
    "prettier": "^3.6.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rimraf": "^6.0.1",
    "secretlint": "^11.3.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "standardx": {
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint/eslint-plugin"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "prettier"
    ]
  },
  "pre-push": [
    "checktidy"
  ],
  "dependencies": {
    "@changesets/cli": "^2.29.7",
    "globals": "^17.3.0",
    "npm-check-updates": "^19.4.1"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
