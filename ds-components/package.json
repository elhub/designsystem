{
  "name": "@elhub/ds-components",
  "version": "4.14.0",
  "description": "Elhub design system components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:elhub/elhub-ui-design-system.git",
    "directory": "ds-components"
  },
  "publishConfig": {
    "registry": "https://jfrog.elhub.cloud/artifactory/api/npm/elhub-npm-release-local/"
  },
  "type": "module",
  "module": "dist/ds-components.js",
  "main": "dist/ds-components.js",
  "types": "dist/ds-components.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "clean": "rimraf dist node_modules",
    "dist": "npm run build",
    "build": "rimraf ./dist && tsc --noEmit && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier --config ../.prettierrc -c \"src/**/*.{ts,tsx}\"",
    "prettier:fix": "prettier --config ../.prettierrc -w \"src/**/*.{ts,tsx}\"",
    "release": "npm publish || exit 0",
    "test": "vitest --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest --passWithNoTests --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elhub/ds-icons": "^4.8.0",
    "@floating-ui/react-dom": "^2.1.1",
    "@popperjs/core": "^2.11.8",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "react-collapse": "^5.1.1",
    "react-datepicker": "^9.1.0",
    "react-merge-refs": "^2.1.1",
    "react-modal": "^3.16.1",
    "react-popper": "^2.3.0",
    "styled-components": "^6.1.13"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "devDependencies": {
    "@types/react-collapse": "^5.0.4",
    "@types/react-dom": "^19.0.0",
    "@types/react-modal": "^3.16.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0"
  },
  "engines": {
    "node": "^12.20.0 || ^14.13.1 || >=16.0.0"
  }
}
