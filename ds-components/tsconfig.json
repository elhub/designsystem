{
  "compilerOptions": {
    "baseUrl": "src",
    "removeComments": true,
    "allowJs": false,
    "skipLibCheck": true,
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "target": "ES2020",
    "moduleResolution": "node",
    "module": "esnext",
    "declaration": true,
    "outDir": "./dist",
    "noEmit": false,
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
