{
  "name": "@elhub/ds-css",
  "version": "6.5.0",
  "description": "CSS for Elhub design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:elhub/designsystem.git",
    "directory": "ds-css"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.css",
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rimraf dist node_modules",
    "copyfonts": "mkdir dist/fonts && cp -r src/fonts/**/* dist/fonts/",
    "prebuild": "npm run embedfonts",
    "build": "rimraf dist/* && postcss --config postcss.config.js -o dist/index.css src/index.css && npm run copyfonts",
    "dist": "npm run build",
    "embedfonts": "ts-node ./src/scripts/embed.ts",
    "lint": "stylelint 'src/**/*.css'",
    "lint:fix": "stylelint 'src/**/*.css' --fix",
    "prettier": "prettier --config ../.prettierrc -c \"src/**/*.{css}\"",
    "prettier:fix": "prettier --config ../.prettierrc -w \"src/**/*.{css}\"",
    "test": "",
    "test:ci": "",
    "typecheck": ""
  },
  "dependencies": {
    "@elhub/ds-tokens": "^7.2.1",
    "rc-motion": "^2.9.2",
    "react-datepicker": "^9.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "normalize.css": "^8.0.1",
    "postcss": "^8.4.44",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "postcss-reporter": "^7.1.0",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-selector-bem-pattern": "^4.0.1"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  }
}
